# AudioRanobe frontend — copy to .env and edit.

# Public URL of the backend API (as seen from the user's browser)
NEXT_PUBLIC_API_URL=http://your-backend-host:8080/api

# Public URL of the frontend itself (used for OG/Twitter metadata)
NEXT_PUBLIC_SITE_URL=https://audioranobe.com

# Umami analytics — optional, unset disables tracking entirely
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SERVER_URL=https://cloud.umami.is
# NEXT_PUBLIC_UMAMI_DOMAINS=

# Port to expose the frontend on
FRONTEND_PORT=3000
